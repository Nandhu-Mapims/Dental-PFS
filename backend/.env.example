PORT=5000

MONGODB_URI=mongodb://localhost:27017/apdch_feedback

# Required in production (the Docker image runs with NODE_ENV=production): logins fail
# without it. Use a long random value and keep it stable, or everyone is signed out on restart.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clear DB and load demo departments, services, and sample feedback:
#   npm run seed-mock -- --yes
SEED_ADMIN_USERNAME=admin
SEED_STAFF_USERNAME=staff
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_PASSWORD=staff123

# Sarvam — speech-to-text for voice feedback (optional)
# https://dashboard.sarvam.ai/ — key must never be exposed to the browser
SARVAM_API_KEY=
# Optional: saaras:v3 (default) or saarika:v2.5
# SARVAM_STT_MODEL=saaras:v3
# For saaras:v3: transcribe | translate | verbatim | translit | codemix
# SARVAM_STT_MODE=codemix

# OpenRouter — AI analysis on each new feedback (optional)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model (default: meta-llama/llama-3.1-8b-instruct). Browse: https://openrouter.ai/models
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# Max service names embedded in AI prompt (names only, pipe-separated; saves tokens)
# OPENROUTER_PROMPT_MAX_SERVICES=40
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional OpenRouter attribution headers
# OPENROUTER_HTTP_REFERER=http://pfs.apdch.mapims.edu.in
# OPENROUTER_APP_TITLE=APDCH Feedback System
# Auto-classify feedback that is still missing AI sentiment (runs in the API process)
# PENDING_AI_POLL_SECONDS=45
# PENDING_AI_BATCH_SIZE=5
# PENDING_AI_MIN_AGE_SECONDS=30
# Regenerate the current week's/month's Summary Report (dept/service AI rollup) on this interval
# SUMMARY_REPORT_POLL_MINUTES=60

# Abuse limits per client IP per 10 minutes for the anonymous patient endpoints (defaults shown).
# RATE_LIMIT_FEEDBACK_PER_10MIN=60
# RATE_LIMIT_VOICE_UPLOAD_PER_10MIN=60
# RATE_LIMIT_SPEECH_PER_10MIN=200
# RATE_LIMIT_AI_INFER_PER_10MIN=100
# RATE_LIMIT_PATIENT_LOOKUP_PER_10MIN=30
# Proxies in front of the API (host nginx + frontend nginx = 2). Use 1 if the API sits behind one proxy.
# TRUST_PROXY_HOPS=2

# Optional: comma-separated origins allowed for /uploads CORS (otherwise *). Example:
# FEEDBACK_CORS_ORIGINS=http://pfs.apdch.mapims.edu.in
#
# If the browser gets HTTP 200 but audio won't play, check that /uploads is NOT served as SPA HTML:
# nginx must proxy /uploads/ to this Node process (see frontend/nginx.conf in this repo).

# ---------------------------------------------------------------------------
# EMR QueryBuilder — optional patient lookup by registration number (UHID)
# ---------------------------------------------------------------------------
# Off unless EMR_QUERY_BUILDER_URL is set; without it patients just enter their name.
# To show the UHID option in the form, also set emrLookupEnabled in frontend/src/app/lib/hospital.ts.
# Browser never sees these values; only the Feedback API calls EMR.
# EMR_COOKIE=
# EMR_QUERY_BUILDER_URL=http://emr.example.org/BB15SE/QueryBuilder/wsQueryBuilder.asmx/Getdataset1
# EMR_STR_CON=BB_CONSTR
# Date literals for report SPs: mdy = MM/DD/YYYY (typical US SQL Server), dmy = DD/MM/YYYY.
# EMR_SQL_DATE_ORDER=mdy
# Optional fixed reporting window (omit to use rolling lookback below).
# EMR_FRMDATE=
# EMR_TODATE=
# When the feedback UI leaves dates blank: from = today − N days, to = today (default 90).
# EMR_LOOKUP_LOOKBACK_DAYS=90
# Set to "true" to force /api/patient/lookup off even when EMR_QUERY_BUILDER_URL is set.
# EMR_PATIENT_LOOKUP_DISABLED=
